<?xml version="1.0"?>
<!--
  Hexapode ECE : corps + 6 pattes (coxa / femur / tibia), 18 x AX-12A.
  Parametres : config/legs.yaml (genere depuis la calibration de leg_gui).
  Reperes (REP-103) : base_link au centre du corps, au niveau des axes de hanche ;
  x vers l'avant, y vers la gauche, z vers le haut.

    xacro hexapod.urdf.xacro [use_imu:=true] [use_lidar:=true] [use_camera:=true]
-->
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="legs_yaml" default="$(find hexapod_description)/config/legs.yaml"/>
  <xacro:arg name="use_imu" default="false"/>
  <xacro:arg name="use_lidar" default="false"/>
  <xacro:arg name="use_camera" default="false"/>

  <xacro:include filename="$(find hexapod_description)/urdf/common.xacro"/>
  <xacro:include filename="$(find hexapod_description)/urdf/leg.xacro"/>
  <xacro:include filename="$(find hexapod_description)/urdf/sensors.xacro"/>

  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg legs_yaml)')}"/>

  <!-- Projection au sol du corps (REP-120), utile pour la navigation -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Corps : plaques haute et basse (262 x 202 mm), plaques laterales et entretoises,
       extraits du STEP SolidWorks "Hexapod Bas1ma Haz1r" (meshes/body.stl, en mm, deja
       dans le repere du robot : centre du corps, axes des hanches a z = 0) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://hexapod_description/meshes/body.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="noir"/>
    </visual>
    <collision>
      <geometry><box size="0.262 0.202 0.040"/></geometry>
    </collision>
    <xacro:box_inertial m="${cfg['masses']['body']}" x="0.262" y="0.202" z="0.040"/>
  </link>

  <xacro:leg n="1" cfg="${cfg}"/>
  <xacro:leg n="2" cfg="${cfg}"/>
  <xacro:leg n="3" cfg="${cfg}"/>
  <xacro:leg n="4" cfg="${cfg}"/>
  <xacro:leg n="5" cfg="${cfg}"/>
  <xacro:leg n="6" cfg="${cfg}"/>

  <xacro:sensors use_imu="$(arg use_imu)" use_lidar="$(arg use_lidar)" use_camera="$(arg use_camera)"/>
</robot>

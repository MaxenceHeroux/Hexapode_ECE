#!/bin/sh
# NetworkManager dispatcher (Pi) : quand le cable Ethernet apparait / disparait, le noeud IMU
# est relance pour que ROS (CycloneDDS) utilise la bonne liaison (cable ou hotspot Wi-Fi).
IFACE="$1"; ACTION="$2"
[ "$IFACE" = "eth0" ] || exit 0
case "$ACTION" in
  up|down) systemctl try-restart hexapode-imu.service ;;
esac
exit 0

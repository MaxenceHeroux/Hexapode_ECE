# leg_server (servos Dynamixel) demarre au boot de la Pi. Installe par install_pi_services.sh
[Unit]
Description=Hexapode : leg_server (18 servos AX-12A, TCP 5555)
After=network.target
StartLimitIntervalSec=0

[Service]
User=hexa-pi
WorkingDirectory=/home/hexa-pi/Hexapode_ECE/Dyna_test
ExecStart=/home/hexa-pi/Hexapode_ECE/Dyna_test/bin/leg_server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
